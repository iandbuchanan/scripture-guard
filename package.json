{
  "name": "scripture-guard",
  "version": "0.1.0",
  "description": "Keep a language model from writing Scripture: detect, strike and refuse passage text in model input and output.",
  "license": "MIT",
  "author": "Ian Buchanan",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "node --test test/*.test.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "bible",
    "scripture",
    "llm",
    "guardrails",
    "ai-safety",
    "hallucination"
  ],
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
